# Copie este arquivo para .env e substitua os valores pelos seus dados locais.
# Se a senha do PostgreSQL tiver caracteres especiais, codifique-os para URL.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/quizflow?schema=public"

# Gere uma chave privada com:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA"

PORT=3000
